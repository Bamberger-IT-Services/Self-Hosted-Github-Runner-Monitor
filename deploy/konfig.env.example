# /etc/runner-monitor/konfig.env – Einstellungen des Runner-Monitors (root:runner-monitor, 0640).
# Alle Werte sind optional. Nach Änderungen: sudo systemctl restart runner-monitor runner-monitor-sammler

# Port der Oberfläche (die Firewall-Regel setzt das Einrichtungsskript)
MONITOR_PORT=8090

# GitHub-Organisation, deren Workflows angezeigt werden (wird auch in der Einrichtung gesetzt)
MONITOR_ORG=beispiel-org

# Installationsordner des Runners
MONITOR_RUNNER_VERZ=/opt/actions-runner

# Unter so vielen GB frei auf „/“ warnt der Monitor (der Runner räumt dann vor jedem Job auf)
MONITOR_SCHWELLE_FREI_GB=25

# Anzeigename der VM (leer: Hostname)
MONITOR_VM_NAME=

# Labels des Runners, falls GitHub nicht abgefragt werden kann
RUNNER_LABELS=self-hosted,linux,x64

# Woher Updates kommen (nur ändern, wer einen eigenen Fork betreibt)
MONITOR_RELEASE_REPO=Bamberger-IT-Services/Self-Hosted-Github-Runner-Monitor
